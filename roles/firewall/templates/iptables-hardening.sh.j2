#!/bin/bash
set -euo pipefail

# Containers reach anything; from outside, published ports are reachable only on 80/443 and firewall_docker_allowed_ports
docker_user_rules() {
  local ipt=$1

  $ipt -w -n -L DOCKER-USER >/dev/null 2>&1 || return 0
  cat <<EOF
-F DOCKER-USER
-A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
-A DOCKER-USER -i docker0 -j RETURN
-A DOCKER-USER -i br-+ -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdstport 80 -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdstport 443 -j RETURN
{% for port in firewall_docker_allowed_ports %}
{% set parts = (port | string).split('/') %}
-A DOCKER-USER -p {{ parts[1] | default('tcp') }} -m conntrack --ctorigdstport {{ parts[0] }} -j RETURN
{% endfor %}
-A DOCKER-USER -j DROP
EOF
}

# iptables-restore commits the table in one transaction, so a failed run keeps the previous rules
apply_rules() {
  local ipt=$1 icmp=$2 dhcp=$3

  ${ipt}-restore -w --noflush <<EOF
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
-F INPUT
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -p $icmp -j ACCEPT
-A INPUT $dhcp -j ACCEPT
-A INPUT -p tcp --dport 22 -j ACCEPT
$(docker_user_rules "$ipt")
COMMIT
EOF
}

apply_rules iptables icmp "-p udp --sport 67 --dport 68"
apply_rules ip6tables ipv6-icmp "-p udp -s fe80::/10 --sport 547 -d fe80::/10 --dport 546"
