#!/bin/bash
set -e

apply_input_rules() {
  local ipt=$1

  $ipt -P INPUT ACCEPT
  $ipt -F INPUT
  $ipt -P OUTPUT ACCEPT
  $ipt -P FORWARD ACCEPT

  $ipt -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  $ipt -A INPUT -i lo -j ACCEPT
  $ipt -A INPUT -m conntrack --ctstate INVALID -j DROP
  $ipt -A INPUT -p tcp ! --syn -m conntrack --ctstate NEW -j DROP

  $ipt -A INPUT -p tcp --syn \
    -m hashlimit --hashlimit-name syn-flood \
    --hashlimit-above 50/second --hashlimit-burst 200 \
    --hashlimit-mode srcip -j DROP

  $ipt -A INPUT -p tcp --dport 22 \
    -m hashlimit --hashlimit-name ssh-limit \
    --hashlimit {{ ssh_rate_per_minute }}/minute --hashlimit-burst {{ ssh_rate_per_minute }} \
    --hashlimit-mode srcip -j ACCEPT
  $ipt -A INPUT -p tcp --dport 22 -j DROP
}

apply_docker_user_rules() {
  local ipt=$1

  $ipt -n -L DOCKER-USER >/dev/null 2>&1 || return 0
  $ipt -F DOCKER-USER

  for port in 80 443; do
    $ipt -A DOCKER-USER -p tcp -m conntrack --ctstate NEW --ctorigdstport "$port" \
      -m hashlimit --hashlimit-name "http-limit-$port" \
      --hashlimit-above {{ http_rate_per_minute }}/minute --hashlimit-burst {{ http_rate_burst }} \
      --hashlimit-mode srcip -j DROP
  done

  $ipt -A DOCKER-USER -j RETURN
}

apply_input_rules iptables
apply_input_rules ip6tables

ip6tables -A INPUT -p ipv6-icmp -j ACCEPT

iptables -A INPUT -p icmp --icmp-type echo-request \
  -m hashlimit --hashlimit-name icmp-limit \
  --hashlimit 5/second --hashlimit-burst 10 \
  --hashlimit-mode srcip -j ACCEPT

iptables -P INPUT DROP
ip6tables -P INPUT DROP

apply_docker_user_rules iptables
apply_docker_user_rules ip6tables
